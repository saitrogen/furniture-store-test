---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Furniture Store' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="bg-white border-b border-border">
      <div class="container-max py-4">
        <h1 class="text-2xl font-bold text-brand">🪑 Furniture Store</h1>
        <p class="text-sm text-text-muted mt-1">Quality furniture — Browse & connect directly</p>
      </div>
    </header>

    <main class="container-max py-8">
      <slot />
    </main>

    <footer class="bg-white border-t border-border mt-12">
      <div class="container-max py-6 text-center text-sm text-text-muted">
        <p>&copy; 2024 Furniture Store. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
