---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Furniture Store' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Discover beautiful Nordic-inspired furniture pieces." />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="container-max">
        <h1>🪑 Furniture Store</h1>
        <p>Quality furniture — Browse & connect directly</p>
      </div>
    </header>

    <main>
      <div class="container-max">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container-max">
        <p>&copy; 2024 Furniture Store. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
  }
</style>
